{
  "expo": {
    "name": "613 Barbershop",
    "slug": "barbershop-613",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.barbershop613.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "613 Barbershop uses your camera to let you update your profile photo and upload haircut photos.",
        "NSPhotoLibraryUsageDescription": "613 Barbershop accesses your photo library to let you choose a profile picture.",
        "NSPhotoLibraryAddUsageDescription": "613 Barbershop saves haircut photos to your photo library.",
        "NSUserNotificationsUsageDescription": "613 Barbershop sends you appointment reminders and booking confirmations."
      }
    },
    "android": {
      "package": "com.barbershop613.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-camera",
      "expo-image-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#D4AF37"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "barbershop-613"
      }
    }
  }
}
