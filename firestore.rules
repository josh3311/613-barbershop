rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function clientBarberRatingAggregateUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['rating', 'reviewCount', 'updatedAt'])
        && request.resource.data.rating is number
        && request.resource.data.reviewCount is number
        && request.resource.data.reviewCount
          == (resource.data.keys().hasAll(['reviewCount']) ? resource.data.reviewCount : 0) + 1;
    }

    // Users can only read/write their own document and AI stylist chat sessions
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /styleChats/{chatId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Bookings: clients create their own bookings; barbers can read/update bookings assigned to them.
    // Firestore validates list queries by checking that all returned documents satisfy the rule —
    // a WHERE clause like where('clientId','==',uid) guarantees clientId==request.auth.uid, so it passes.
    match /bookings/{bookingId} {
      allow create: if request.auth != null
        && request.resource.data.clientId == request.auth.uid;
      allow read, list: if request.auth != null && (
        resource.data.clientId == request.auth.uid
        || resource.data.barberId == request.auth.uid
        || isAdmin()
      );
      allow update: if request.auth != null
        && (resource.data.barberId == request.auth.uid
            || resource.data.clientId == request.auth.uid);
    }

    // Barbers: any authenticated user can read; barber or admin can manage profile;
    // authenticated clients may update only aggregate rating fields after submitting a rating doc.
    match /barbers/{barberId} {
      // All authenticated users (including admins) may read barber profiles for booking UI.
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && (request.auth.uid == barberId || isAdmin());
      allow update: if request.auth != null
        && (
          request.auth.uid == barberId
          || isAdmin()
          || clientBarberRatingAggregateUpdate()
        );
      allow delete: if request.auth != null
        && (request.auth.uid == barberId || isAdmin());
    }

    // Services: any authenticated user can read; only admins can write
    match /services/{serviceId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Haircut history: client or barber of that record can read; barbers can create
    match /haircutHistory/{historyId} {
      allow read: if request.auth != null
        && (resource.data.clientId == request.auth.uid
            || resource.data.barberId == request.auth.uid);
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && resource.data.barberId == request.auth.uid;
    }

    match /ratings/{ratingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.keys().hasAll(['bookingId', 'clientId', 'barberId', 'rating']);
      allow update, delete: if false;
    }

    match /conversations/{convId} {
      allow read: if request.auth != null && (
        !exists(/databases/$(database)/documents/conversations/$(convId)) ||
        request.auth.uid in resource.data.participantIds
      );
      allow create: if request.auth != null
        && request.resource.data.participantIds is list
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.keys().hasAll(['participantIds', 'clientId', 'barberId', 'updatedAt']);
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participantIds;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds
          && request.resource.data.senderId == request.auth.uid;
      }
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
