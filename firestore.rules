rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users — owner can read/write; admin can read/write any user doc;
    // barbers can update ONLY loyaltyStamps on any user doc
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'barber' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['loyaltyStamps'])
        )
      );
      allow create: if request.auth != null &&
        request.auth.uid == userId;
    }

    // Services are public read, admin write only
    match /services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Barbers are public read, admin write only
    match /barbers/{barberId} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Bookings — client, barber, or admin can read their own
    match /bookings/{bookingId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.clientId ||
        request.auth.uid == resource.data.barberId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.barberId ||
        request.auth.uid == resource.data.clientId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Messages — only booking participants can read/write
    match /messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    // Ratings — authenticated users only
    match /ratings/{ratingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
