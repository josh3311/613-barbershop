rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Bookings: clients create their own bookings; barbers can read/update bookings assigned to them.
    // Firestore validates list queries by checking that all returned documents satisfy the rule —
    // a WHERE clause like where('clientId','==',uid) guarantees clientId==request.auth.uid, so it passes.
    match /bookings/{bookingId} {
      allow create: if request.auth != null
        && request.resource.data.clientId == request.auth.uid;
      allow read, list: if request.auth != null
        && (resource.data.clientId == request.auth.uid
            || resource.data.barberId == request.auth.uid);
      allow update: if request.auth != null
        && (resource.data.barberId == request.auth.uid
            || resource.data.clientId == request.auth.uid);
    }

    // Barbers: any authenticated user can read; only the barber or an admin can write
    match /barbers/{barberId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && (request.auth.uid == barberId
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Services: any authenticated user can read; only admins can write
    match /services/{serviceId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Haircut history: client or barber of that record can read; barbers can create
    match /haircutHistory/{historyId} {
      allow read: if request.auth != null
        && (resource.data.clientId == request.auth.uid
            || resource.data.barberId == request.auth.uid);
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && resource.data.barberId == request.auth.uid;
    }

    // Conversations: only the two participants can read/write
    // (create uses request.resource; read/update use resource — not combined on one line)
    match /conversations/{conversationId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participantIds;
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.participantIds;

      match /messages/{messageId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds &&
          request.resource.data.senderId == request.auth.uid;
      }
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
