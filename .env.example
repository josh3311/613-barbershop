# Copy this file to `.env` in the project root (same folder as package.json).
# Expo loads EXPO_PUBLIC_* at bundle time for web, iOS, Android, and Expo Go.
# Never commit `.env` (it is gitignored).

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# AI backend (Go) — same host as Expo uses in dev (see src/services/ai.service.ts)
EXPO_PUBLIC_AI_BACKEND_URL=http://127.0.0.1:8080

# Style preview photos use the Go backend (/api/style-photo). Set UNSPLASH_ACCESS_KEY in backend/.env (not required here).
